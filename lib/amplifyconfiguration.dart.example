  "UserAgent": "aws-amplify-cli/2.0",
  "Version": "1.0",
  "auth": {
    "plugins": {
      "awsCognitoAuthPlugin": {

        "UserAgent": "aws-amplify-cli/0.1.0",
        "Version": "0.1.0",

        "IdentityManager": {
          "Default": {}
        },

        "CognitoUserPool": {
          "Default": {
            "PoolId": "ap-northeast-1_XXXXXXXXX",   // ← ユーザープールID
            "AppClientId": "XXXXXXXXXXXXXXXXXX",     // ← アプリクライアントID
            "Region": "ap-northeast-1"               // ← リージョン
          }
        },

        "Auth": {
          "Default": {
            "authenticationFlowType": "USER_SRP_AUTH"
          }
        }

      }
    }
  }
}''';